# ===== 教會設定（每間教會各自一份） =====
# 教會代碼：只能用小寫英文、數字與連字號，部署後不可更改
CHURCH_SLUG=church-a
# 教會顯示名稱（會顯示在網頁標題與登入頁）
NEXT_PUBLIC_CHURCH_NAME=恩典教會
# 介面主色（CSS 顏色值）
NEXT_PUBLIC_CHURCH_ACCENT=#2563eb

# ===== 網站網址 =====
# 正式網址，不要有結尾斜線。Passkey 綁定此網域，上線後更改會讓既有 Passkey 失效
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===== 資料庫（Supabase 專案的 Postgres 連線字串，或本機 Postgres） =====
# Supabase：專案設定 → Database → Connection string → Transaction pooler (port 6543)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/church_directory

# ===== 登入安全金鑰 =====
# 執行 `openssl rand -base64 32` 產生，每間教會不同，絕不可外流
BETTER_AUTH_SECRET=change-me-to-a-random-32-byte-string

# ===== 照片儲存 =====
# local = 存在伺服器的 ./storage 資料夾（僅限本機開發）
# supabase = Supabase Storage 私有 bucket（正式環境）
STORAGE_DRIVER=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=member-files

# ===== 第一位管理員（只在執行 npm run db:seed 時使用） =====
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-please
SEED_ADMIN_NAME=系統管理員
